{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./*"],

      "~/*": ["app/*", "components/*"],

      "@components/*": ["components/*"],
      "@app/*": ["app/*"],

      "@blayzit/*": ["components/blayzit/*"],
      "@dnip/*": ["components/blayzit/dnip/*"],
      "@adip/*": ["components/blayzit/adip/*"],
      "@telemetry/*": ["components/blayzit/telemetry/*"],
      "@ui/*": ["components/ui/*"],
      "@wow/*": ["components/wow/*"]
    },

    "incremental": true,
    "plugins": [{ "name": "next" }]
  },

  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],

  "exclude": ["node_modules"]
}